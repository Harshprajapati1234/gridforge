{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@gridforge/shared": [
        "packages/shared/src/index.ts"
      ],
      "@gridforge/sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@gridforge/core": [
        "packages/core/src/index.ts"
      ],
      "@gridforge/ui-kit": [
        "packages/ui-kit/src/index.ts"
      ],
      "@gridforge/module-host": [
        "packages/module-host/src/index.ts"
      ],
      "@gridforge/formula": [
        "packages/formula/src/index.ts"
      ],
      "@gridforge/grid": [
        "packages/grid/src/index.ts"
      ],
      "@gridforge/bridge": [
        "packages/bridge/src/index.ts"
      ],
      "@gridforge/bridge-service": [
        "packages/bridge-service/src/index.ts"
      ]
    }
  }
}